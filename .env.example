# Copy to .env (local) or .env.docker (Docker dev) and fill in real values.
# Never commit the copies - only this example file is tracked.

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Signs the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Database -----------------------------------------------------------
# Local Postgres. Under Docker dev, docker-compose overrides this with the
# internal "database" service address.
DATABASE_URL=postgresql://portpilot:devpassword@localhost:5432/portpilot

# Docker dev only: credentials for the Postgres container
POSTGRES_DB=portpilot
POSTGRES_USER=portpilot
POSTGRES_PASSWORD=devpassword

# --- GitHub OAuth -------------------------------------------------------
# Create an OAuth App (not a GitHub App) at https://github.com/settings/developers
# with this exact callback URL, and leave "Expire user access tokens" unchecked.
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# --- AI project analysis ------------------------------------------------
# Required for the "Analyze" button. Must start with sk-.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: any chat model that supports JSON mode (default: gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# --- Stripe (not used yet) ----------------------------------------------
# Billing endpoints are stubs; these are placeholders for when checkout is built.
# VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PRICE_ID=price_your_pro_plan_price_id
